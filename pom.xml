<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.huawei.cloudsop</groupId>
  <artifactId>openui-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OpenUI Java Aggregator</name>
  <description>Aggregator-only build for the Java Generation SDK and the eval CLI.</description>

  <properties>
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.version>10.21.2</checkstyle.version>
    <spotbugs.plugin.version>4.8.6.6</spotbugs.plugin.version>
    <findsecbugs.version>1.13.0</findsecbugs.version>
    <fmt.plugin.version>2.25</fmt.plugin.version>
    <pmd.plugin.version>3.26.0</pmd.plugin.version>
    <pmd.version>7.7.0</pmd.version>
    <!-- 子模块覆盖为 ${project.basedir}/../../config -->
    <lint.config.dir>${project.basedir}/config</lint.config.dir>
  </properties>

  <modules>
    <!-- 自定义 PMD 规则必须先于被检查模块构建，maven-pmd-plugin 从 reactor 加载规则类。 -->
    <module>tools/lint-rules</module>
    <module>packages/genui-java-sdk</module>
    <module>packages/genui-eval-cli</module>
  </modules>

  <!--
    插件统一放在父 POM，子模块通过 <parent> 继承。
    格式以 fmt-maven-plugin（AOSP）为唯一标准；原 Spotless（Eclipse 120 列）已移除。
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.plugin.version}</version>
        <executions>
          <execution>
            <id>checkstyle-validation</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <!-- 提到插件级，使手动 checkstyle:check 与 verify 判定的告警级别一致 -->
          <violationSeverity>warning</violationSeverity>
          <configLocation>${lint.config.dir}/checkstyle/checkstyle.xml</configLocation>
          <!-- 让规则集内的 ${lint.config.dir} 可解析（SuppressionXpathFilter 的豁免文件路径） -->
          <propertyExpansion>lint.config.dir=${lint.config.dir}</propertyExpansion>
          <suppressionsLocation>${lint.config.dir}/checkstyle/suppressions.xml</suppressionsLocation>
          <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
          <consoleOutput>true</consoleOutput>
          <failsOnError>false</failsOnError>
          <inputEncoding>UTF-8</inputEncoding>
          <sourceDirectories>
            <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
          </sourceDirectories>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.plugin.version}</version>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <failOnError>true</failOnError>
          <xmlOutput>true</xmlOutput>
          <includeTests>false</includeTests>
          <includeFilterFile>${lint.config.dir}/spotbugs/spotbugs-include.xml</includeFilterFile>
          <excludeFilterFile>${lint.config.dir}/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <version>${fmt.plugin.version}</version>
        <configuration>
          <style>AOSP</style>
          <filesToExclude>
            **/generated-sources/**/*.java
          </filesToExclude>
        </configuration>
        <executions>
          <execution>
            <id>fmt-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        PMD 负责 Checkstyle 做不了的类型语义规则：G.FMT.20（字面量后缀）、
        G.OBJ.04（局部变量遮蔽字段）、G.CTL.05（循环体内改循环变量）。
        插件依赖自定义规则模块；执行绑定在各子模块，避免聚合 pom 与规则模块
        在自身构建阶段解析尚未产出的规则 jar。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>${lint.config.dir}/pmd/pmd-ruleset.xml</ruleset>
          </rulesets>
          <typeResolution>true</typeResolution>
          <includeTests>false</includeTests>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.huawei.cloudsop</groupId>
            <artifactId>genui-lint-rules</artifactId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
