<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Regression ruleset: only the six Checkstyle rules covered by this fixture project.
    It intentionally does not import the production ruleset so unrelated rule or suppression
    work does not change the regression baseline.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <module name="RegexpHeader">
        <property name="header"
                  value="^/\*$\n^ \* Copyright \(c\) Huawei Technologies Co\., Ltd\. \d{4}(-\d{4})?\. All rights reserved\.$\n^ \*/$"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
        </module>
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public,protected"/>
            <property name="validateThrows" value="true"/>
        </module>
        <module name="SummaryJavadoc"/>
        <module name="WriteTag">
            <property name="tag" value="@since"/>
            <property name="tagFormat" value="\S.*"/>
            <property name="tagSeverity" value="ignore"/>
        </module>
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="WriteTag"/>
            <property name="query"
                      value="//*[self::CLASS_DEF or self::INTERFACE_DEF or self::ENUM_DEF or self::ANNOTATION_DEF or self::RECORD_DEF][not(parent::COMPILATION_UNIT) or not(MODIFIERS/LITERAL_PUBLIC)]"/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="max" value="5"/>
        </module>
    </module>
</module>
