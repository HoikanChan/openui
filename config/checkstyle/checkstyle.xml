<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    SmartCanvas Checkstyle 配置（verify 阶段强制检查）
    等效替代 CodeCheckCLI 中的 fixbotengine-java + cMetrics 部分规则。
    此文件是 Maven/CI 唯一启用的 Checkstyle 规则集。
    华为规则中的类型语义检查由 PMD 补充；不要维护未被构建引用的平行规则集。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- 文件末尾换行 -->
    <module name="NewlineAtEndOfFile"/>

    <!-- 禁止 Tab -->
    <module name="FileTabCharacter"/>

    <!-- 文件长度（替代 cMetrics huge_non_headerfile=2000） -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- 头文件检查（替代 fixbotengine-java FileHeaderComment），沿用仓库既有版权头格式 -->
    <module name="RegexpHeader">
        <property name="header"
                  value="^/\*$\n^ \* Copyright \(c\) Huawei Technologies Co\., Ltd\. \d{4}(-\d{4})?\. All rights reserved\.$\n^ \*/$"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
        <property name="optional" value="true"/>
    </module>

    <module name="TreeWalker">
        <!-- 方法级豁免：按类名+方法名匹配，见 suppressions-xpath.xml -->
        <module name="SuppressionXpathFilter">
            <property name="file" value="${lint.config.dir}/checkstyle/suppressions-xpath.xml"/>
        </module>

        <!-- G.CMT.02 / G.CMT.03：文档存在性、功能说明、参数/返回值/异常标签 -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
        <!--
          G.CMT.02 只要求顶层 public 类型带 @since；这里对所有已写 Javadoc 的类型统一要求，
          比规范更严格一档：嵌套类型同样对外可见，单独豁免需要按 AST 节点过滤，
          而 WriteTag 的违规挂点不支持 XPath 豁免（实测无效），维护两套判定反而更脆。
        -->
        <module name="WriteTag">
            <property name="tag" value="@since"/>
            <property name="tagFormat" value="\S.*"/>
            <property name="tagSeverity" value="ignore"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
        </module>
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public,protected"/>
            <property name="validateThrows" value="true"/>
        </module>
        <!-- 功能说明：首句必须存在并以标点结束；中文句号同样算数 -->
        <module name="JavadocStyle">
            <property name="scope" value="protected"/>
            <property name="checkFirstSentence" value="true"/>
            <property name="checkEmptyJavadoc" value="true"/>
            <property name="endOfSentenceFormat"
                      value="([.?!。][ \t\n\r\f&lt;])|([.?!。:]$)"/>
        </module>

        <!-- G.CTL.01：每个布尔表达式最多五个逻辑运算符 -->
        <module name="BooleanExpressionComplexity">
            <property name="max" value="5"/>
        </module>
        <module name="UpperEll"/>

        <!-- ========== 命名规范 ========== -->
        <module name="ConstantName"/>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>

        <!-- ========== 导入规范 ========== -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- ========== 代码块规范（替代 fixbotengine-java 大括号规则） ========== -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
        </module>
        <module name="LeftCurly"/>
        <module name="NeedBraces"/>
        <module name="RightCurly"/>

        <!-- ========== 代码质量 ========== -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>

        <!-- ========== 方法长度（替代 fixbotengine-java IdentifierName maxLength=64） ========== -->
        <module name="MethodLength">
            <property name="max" value="150"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- ========== 参数数量 ========== -->
        <module name="ParameterNumber">
            <property name="max" value="7"/>
        </module>

        <!-- ========== 圈复杂度（替代 cMetrics huge_cyclomatic_complexity=20，这里设更严格的15） ========== -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>

        <!-- ========== 类数据抽象耦合 ========== -->
        <module name="ClassDataAbstractionCoupling">
            <property name="max" value="20"/>
        </module>

        <!-- ========== 魔法值 ========== -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>

        <!--
            不启用 FinalLocalVariable：与 Google/AOSP 风格一致（fmt 即 AOSP），
            避免为 1200+ 处局部变量补 final 产生纯噪音 diff。
        -->
    </module>
</module>
