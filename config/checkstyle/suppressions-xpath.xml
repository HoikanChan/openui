<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionXpathFilter Experimental Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2_xpath_experimental.dtd">
<!--
  由 checkstyle.xml 中 TreeWalker 的 SuppressionXpathFilter 读取。
  按「类名 + 方法名」定位，不写行号：行号会随 Javadoc、空行等无关改动漂移，
  导致豁免静默失效（该拦的没拦住），或反过来误伤挪到该行的新方法（不该拦的拦了）。
-->
<suppressions>
  <!-- 类型分析核心：AnalysisSession 是语义分析的主循环 -->
  <suppress-xpath files="AnalysisSession\.java" checks="ParameterNumber"
            query="//METHOD_DEF[./IDENT[@text='checkComponentParam'] or ./IDENT[@text='checkObligation'] or ./IDENT[@text='checkTableColumn']]/descendant-or-self::node()"/>
  <suppress-xpath files="AnalysisSession\.java" checks="ClassDataAbstractionCoupling"
            query="//CLASS_DEF[./IDENT[@text='AnalysisSession']]"/>

  <!--
    长参数列表：契约 record 的规范构造器/工厂直接镜像 base-contract.json 字段，
    再包一层参数对象只会增加一层无名字段映射。
  -->
  <suppress-xpath files="BuiltinSpec\.java" checks="ParameterNumber"
            query="//CTOR_DEF[./IDENT[@text='BuiltinSpec']]/descendant-or-self::node()"/>
  <suppress-xpath files="GenerationContract\.java" checks="ParameterNumber"
            query="//CTOR_DEF[./IDENT[@text='GenerationContract']]/descendant-or-self::node()"/>
  <suppress-xpath files="UiGenerationRequest\.java" checks="ParameterNumber"
            query="//CTOR_DEF[./IDENT[@text='UiGenerationRequest']]/descendant-or-self::node()"/>
  <suppress-xpath files="ProgramAnalyzer\.java" checks="ParameterNumber"
            query="//METHOD_DEF[./IDENT[@text='emit']]/descendant-or-self::node()"/>
</suppressions>
