<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  由 checkstyle.xml 中 Checker 级的 SuppressionFilter 读取，只放文件/行级豁免。
  方法级豁免写在 suppressions-xpath.xml（按类名+方法名匹配，不随行号漂移）。
-->
<suppressions>
  <!-- 生成代码与构建产物不检查 -->
  <suppress files="[\\/]target[\\/]" checks=".*"/>
  <suppress files="[\\/]generated-sources[\\/]" checks=".*"/>

  <!-- AnalysisSession 超过 2000 行：语义分析主类按职责拆分的收益低于审查连贯性 -->
  <suppress files="AnalysisSession\.java" checks="FileLength" lines="1"/>
</suppressions>
