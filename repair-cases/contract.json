{
  "contractVersion": "interception-corpus-v1",
  "root": "root",
  "components": {
    "Stack": {
      "description": "Flex container",
      "propsSchema": {
        "type": "object",
        "properties": {
          "children": { "type": "array" },
          "direction": { "type": "string" },
          "gap": { "type": "string" },
          "align": { "type": "string" },
          "justify": { "type": "string" }
        },
        "required": ["children"]
      }
    },
    "TextContent": {
      "description": "Text block",
      "propsSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "variant": { "type": "string" }
        },
        "required": ["text"]
      }
    },
    "Table": {
      "description": "Table",
      "propsSchema": {
        "type": "object",
        "properties": {
          "columns": { "type": "array" },
          "rows": { "type": "array" }
        },
        "required": ["columns", "rows"]
      }
    },
    "Col": {
      "description": "Table column",
      "propsSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "field": { "type": "string" },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sortable": { "type": "boolean" },
              "cell": {}
            }
          }
        },
        "required": ["title", "field"]
      }
    },
    "Card": {
      "description": "Card",
      "propsSchema": {
        "type": "object",
        "properties": {
          "children": { "type": "array" },
          "variant": { "type": "string" },
          "size": { "type": "string" }
        },
        "required": ["children"]
      }
    },
    "CardHeader": {
      "description": "Card header",
      "propsSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" }
        },
        "required": ["title"]
      }
    },
    "List": {
      "description": "List",
      "propsSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "title": { "type": "string" }
        },
        "required": ["items"]
      }
    },
    "Series": {
      "description": "Chart series",
      "propsSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "data": { "type": "array" }
        },
        "required": ["name", "data"]
      }
    },
    "BarChart": {
      "description": "Bar chart",
      "propsSchema": {
        "type": "object",
        "properties": {
          "labels": { "type": "array" },
          "series": { "type": "array" },
          "variant": { "type": "string" },
          "xAxis": { "type": "string" },
          "yAxis": { "type": "string" }
        },
        "required": ["labels", "series"]
      }
    },
    "PieChart": {
      "description": "Pie chart",
      "propsSchema": {
        "type": "object",
        "properties": {
          "labels": { "type": "array" },
          "values": { "type": "array" },
          "variant": { "type": "string" }
        },
        "required": ["labels", "values"]
      }
    },
    "LineChart": {
      "description": "Line chart",
      "propsSchema": {
        "type": "object",
        "properties": {
          "labels": { "type": "array" },
          "series": { "type": "array" },
          "variant": { "type": "string" },
          "xAxis": { "type": "string" },
          "yAxis": { "type": "string" }
        },
        "required": ["labels", "series"]
      }
    },
    "Tabs": {
      "description": "Tabs",
      "propsSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "style": {
                "type": "object",
                "additionalProperties": true,
                "properties": {}
              }
            }
          }
        },
        "required": ["items"]
      }
    }
  }
}
