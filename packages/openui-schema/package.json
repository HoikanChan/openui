{
  "name": "@openuidev/openui-schema",
  "version": "0.1.0",
  "description": "Lightweight schema definition library for OpenUI — component contract schemas, introspection, and JSON Schema output",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown && node scripts/patch-dts.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:fix": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "openui",
    "schema",
    "component-contract",
    "introspection",
    "json-schema",
    "generative-ui",
    "llm"
  ],
  "homepage": "https://openui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesysdev/openui.git",
    "directory": "packages/openui-schema"
  },
  "author": "engineering@thesys.dev"
}
