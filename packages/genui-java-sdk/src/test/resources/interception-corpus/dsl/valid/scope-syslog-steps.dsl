root = Stack([header, logSteps])
header = CardHeader("Syslog Records", "Total: " + data.syslogTotal)
logSteps = Steps(@Each(data.syslogResult, "log", logStepTpl))
logStepTpl = StepsItem(log.syslogBrief + " (" + log.neName + ")", logCard)
logCard = Card([timeRow, detailRow], "column", "s")
timeRow = Stack([timeLabel, timeValue], "row", "none", "center")
timeLabel = TextContent("Time: ", "small")
timeValue = TextContent(@FormatDate(log.time, "dateTime"), "small")
detailRow = TextContent(log.syslogDetail, "small")
