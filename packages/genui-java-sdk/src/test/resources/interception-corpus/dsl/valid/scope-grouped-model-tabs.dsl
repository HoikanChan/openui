root = Stack([summaryCard, modelTabs], "column", "m")
summaryCard = Card([summaryHeader, summaryContent], "card", "column", "m", "start", "start", false)
summaryHeader = CardHeader("Online Devices Summary", "Fabric: " + data.fabric)
summaryContent = Stack([totalText, fabricText], "row", "m", "center", "start", false)
totalText = TextContent("Total Online Devices: " + data.total_count, "large-heavy")
fabricText = TextContent("Fabric: " + data.fabric, "default")
modelTabs = Tabs(@Each(data.grouped_by_model, "group", modelTabTpl))
modelTabTpl = TabItem(group.model, group.model + " (" + group.count + " devices)", [modelTable])
modelTable = Table([modelCol, countCol, versionCol, nameCol, ipCol, vendorCol], group.devices)
modelCol = Col("Model", "model", {cell: @Render("v", "row", TextContent(row.model ?? group.model))})
countCol = Col("Count", "count", {cell: @Render("v", "row", TextContent("" + (row.count ?? group.count)))})
versionCol = Col("Version", "version")
nameCol = Col("Device Name", "name")
ipCol = Col("IP", "ip")
vendorCol = Col("Vendor", "vendor")
