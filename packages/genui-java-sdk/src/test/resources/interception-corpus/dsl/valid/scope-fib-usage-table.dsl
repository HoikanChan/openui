root = Stack([header, tableCard], "column", "m")
header = CardHeader("设备板卡资源使用率", "FIB表项利用率监控")
tableCard = Card([table])
table = Table([slotCol, deviceCol, ipCol, macCol, fibv4Col, fibv6Col], data.list)
slotCol = Col("槽位名称", "slot_name")
deviceCol = Col("设备名称", "device_name")
ipCol = Col("设备IP", "device_ip")
macCol = Col("MAC地址", "mac")
fibv4Col = Col("FIBv4利用率", "fibv4_usage", {cell: @Render("v", TextContent(@FormatPercent(v / 100, 1)))})
fibv6Col = Col("FIBv6利用率", "fibv6_usage", {cell: @Render("v", TextContent(@FormatPercent(v / 100, 1)))})
