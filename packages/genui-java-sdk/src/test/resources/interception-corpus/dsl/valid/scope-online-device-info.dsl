root = Stack([header, tableCard], "column", "m")
header = CardHeader("在线设备信息", "共 " + data.deviceTotal + " 台设备")
tableCard = Card([deviceTable])
deviceTable = Table([nameCol, ipCol, typeCol, vendorCol, roleCol, versionCol, categoryCol, fabricCol], data.deviceInfo)
nameCol = Col("设备名称", "neName")
ipCol = Col("IP 地址", "neIp")
typeCol = Col("设备型号", "neType")
vendorCol = Col("厂商", "neVendor")
roleCol = Col("角色", "neRole")
versionCol = Col("版本", "neVersion")
categoryCol = Col("类别", "neCategory")
fabricCol = Col("Fabric", "fabricName")
