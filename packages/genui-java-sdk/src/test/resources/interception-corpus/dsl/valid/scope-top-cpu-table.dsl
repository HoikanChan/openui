root = Stack([header, tableCard])
header = CardHeader(data.title, "Top 5 devices by CPU usage")
sortedData = @Sort(data.data, "cpu_usage", "desc")
tableCard = Card([deviceTable])
deviceTable = Table([nameCol, ipCol, macCol, cpuCol], sortedData)
nameCol = Col("设备名称", "neName")
ipCol = Col("设备IP", "neIp")
macCol = Col("MAC地址", "mac")
cpuCol = Col("CPU利用率(%)", "cpu_usage", {cell: @Render("v", TextContent(@FormatPercent(v / 100, 2)))})
